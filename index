                    <div>
                        <p class="text-3xl lg:text-4xl font-extrabold text-signiaCyan">+240 mil</p>
                        <p class="text-sm text-slate-300 mt-1">Pedidos anuales a nivel regional</p>
                    </div>
                    <div>
                        <p class="text-3xl lg:text-4xl font-extrabold text-signiaCyan">BPA / BPM</p>
                        <p class="text-sm text-slate-300 mt-1">Certificaciones de calidad</p>
                    </div>
                </div>
            </div>
