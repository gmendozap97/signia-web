    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="bg-signiaBlue text-white font-extrabold text-2xl tracking-wider px-3 py-1.5 rounded">
                    SIGNIA
                </div>
                <span class="text-xs font-semibold uppercase tracking-widest text-slate-500 hidden sm:block">Logistics</span>
            </div>
            
            <nav class="hidden md:flex items-center gap-8 font-medium text-sm text-slate-700">
                <a href="#nosotros" class="hover:text-signiaCyan transition">Nosotros</a>
                <a href="#soluciones" class="hover:text-signiaCyan transition">Soluciones</a>
                <a href="#capacidades" class="hover:text-signiaCyan transition">Capacidades</a>
                <a href="#sectores" class="hover:text-signiaCyan transition">Sectores</a>
