                    </a>
                    <a href="#contacto" class="border border-white/30 hover:bg-white/10 text-white font-bold px-8 py-3.5 rounded-xl text-center transition">
                        Contáctanos
                    </a>
                </div>
            </div>
            <div class="bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/10 shadow-2xl">
                <h3 class="text-xl font-bold mb-6 text-white border-b border-white/10 pb-3">Indicadores Clave</h3>
                <div class="grid grid-cols-2 gap-6">
                    <div>
