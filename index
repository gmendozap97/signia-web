                <p class="text-slate-300 text-sm"><i class="fa-solid fa-envelope mr-2 text-signiaCyan"></i> info@signialogistics.com</p>
            </div>
            <div>
                <h4 class="text-lg font-bold mb-4 text-signiaCyan">Enlaces Rápidos</h4>
                <ul class="space-y-2 text-sm text-slate-300">
                    <li><a href="#nosotros" class="hover:text-signiaCyan transition">Nosotros</a></li>
                    <li><a href="#soluciones" class="hover:text-signiaCyan transition">Soluciones Logísticas</a></li>
                    <li><a href="#capacidades" class="hover:text-signiaCyan transition">Infraestructura y Capacidades</a></li>
                    <li><a href="#sectores" class="hover:text-signiaCyan transition">Sectores</a></li>
