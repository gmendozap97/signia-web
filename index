            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative bg-signiaBlue text-white py-24 lg:py-32 overflow-hidden">
        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#00B4D8_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
                <span class="bg-signiaCyan/20 text-signiaCyan px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Más de 30 años de experiencia</span>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mt-4 leading-tight">
                    Convertimos desafíos en <span class="text-signiaCyan">movimientos eficientes</span>
                </h1>
                <p class="mt-6 text-lg text-slate-300 leading-relaxed">
