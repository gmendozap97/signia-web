    <section id="nosotros" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto">
                <h2 class="text-3xl font-extrabold text-signiaBlue">Nuestros Pilares Estratégicos</h2>
                <p class="mt-4 text-slate-600">Garantizamos una cadena de suministro segura, respaldada por la solidez y el prestigio del Grupo Hersil.</p>
            </div>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-signiaGray p-8 rounded-2xl border border-slate-200">
                    <div class="w-14 h-14 bg-signiaBlue text-signiaCyan rounded-xl flex items-center justify-center text-2xl mb-6">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-3">Cumplimiento y Calidad</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Entregamos los pedidos en el lead time acordado bajo estrictas normativas farmacéuticas y sanitarias (DIGEMID).</p>
                </div>
                <div class="bg-signiaGray p-8 rounded-2xl border border-slate-200">
                    <div class="w-14 h-14 bg-signiaBlue text-signiaCyan rounded-xl flex items-center justify-center text-2xl mb-6">
                        <i class="fa-solid fa-microchip"></i>
                    </div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-3">Tecnología WMS Avanzada</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Operaciones altamente automatizadas con Infor WMS para asegurar la trazabilidad y exactitud absoluta en inventarios.</p>
                </div>
                <div class="bg-signiaGray p-8 rounded-2xl border border-slate-200">
                    <div class="w-14 h-14 bg-signiaBlue text-signiaCyan rounded-xl flex items-center justify-center text-2xl mb-6">
                        <i class="fa-solid fa-handshake"></i>
                    </div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-3">Modelo Tailor Made</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Soluciones personalizadas a la medida exacta de los requerimientos específicos de cada cliente corporativo.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Soluciones Logísticas -->
    <section id="soluciones" class="py-20 bg-signiaGray">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto">
                <h2 class="text-3xl font-extrabold text-signiaBlue">Nuestras Soluciones</h2>
                <p class="mt-4 text-slate-600">Un enfoque integral One Stop Shop para cubrir cada etapa de su cadena de suministro.</p>
            </div>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Solución 1 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                    <div class="text-signiaCyan text-3xl mb-4"><i class="fa-solid fa-boxes-stacked"></i></div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-2">Almacenamiento</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Almacenamiento simple y depósito aduanero con infraestructura moderna y control estricto de temperaturas.</p>
                </div>
                <!-- Solución 2 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                    <div class="text-signiaCyan text-3xl mb-4"><i class="fa-solid fa-truck-fast"></i></div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-2">Distribución y Entrega</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Flota propia y mixta certificada con cobertura de distribución a nivel nacional y tracking online.</p>
                </div>
                <!-- Solución 3 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                    <div class="text-signiaCyan text-3xl mb-4"><i class="fa-solid fa-clipboard-check"></i></div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-2">Acondicionado</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Servicios de maquila, etiquetado, estuchado y reacondicionamiento bajo normativas de buenas prácticas.</p>
                </div>
                <!-- Solución 4 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                    <div class="text-signiaCyan text-3xl mb-4"><i class="fa-solid fa-earth-americas"></i></div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-2">Nacionalización</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Gestión integral y eficiente de procesos aduaneros para la liberación oportuna de mercancías.</p>
                </div>
                <!-- Solución 5 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                    <div class="text-signiaCyan text-3xl mb-4"><i class="fa-solid fa-warehouse"></i></div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-2">Arrendamiento</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Alquiler de espacios logísticos flexibles adaptados a estacionalidades y necesidades operativas.</p>
                </div>
                <!-- Solución 6 -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                    <div class="text-signiaCyan text-3xl mb-4"><i class="fa-solid fa-network-wired"></i></div>
                    <h3 class="text-xl font-bold text-signiaBlue mb-2">Integración Informática</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Interfaces especializadas para conectar los sistemas del cliente con nuestra plataforma en tiempo real.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Capacidades e Infraestructura -->
    <section id="capacidades" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <span class="text-signiaCyan font-bold uppercase tracking-wider text-xs">Infraestructura de vanguardia</span>
