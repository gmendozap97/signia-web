    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        signiaBlue: '#0B2545',
                        signiaLightBlue: '#134074',
                        signiaCyan: '#00B4D8',
                        signiaAccent: '#00A896',
                        signiaGray: '#EEF4F8'
